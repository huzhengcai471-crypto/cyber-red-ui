# Media shipped with the plugin is large, so it lives in Git LFS instead of
# the regular object store. A clone that has git-lfs installed gets the real
# files; one without it gets pointer text.
#
# This matters for the 1.2.0 tree: forgotten-dynamic.mp4 alone is over 50 MB,
# which is above GitHub's recommended per-file limit for ordinary blobs.
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.ogg  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text

# Stills are small, but keeping every bundled asset on one path means the
# install archive and the repo stay byte-identical without juggling rules.
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.png  filter=lfs diff=lfs merge=lfs -text
